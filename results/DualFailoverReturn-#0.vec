config experiment-label DualFailoverReturn
config sim-time-limit 2s
config description abstract
config *.*.hasTimeSynchronization true
config **.tsnClock*.clock.oscillator.typename RandomDriftOscillator
config **.oscillator.changeInterval 12.5ms
config **.oscillator.driftRate "uniform(-100ppm, 100ppm)"
config **.oscillator.driftRateChange "uniform(-1ppm, 1ppm)"
config **.oscillator.driftRateChangeUpperLimit 100ppm
config **.oscillator.driftRateChangeLowerLimit -100ppm
config *.*.eth[*].bitrate 100Mbps
config *.visualizer.typename IntegratedMultiCanvasVisualizer
config *.visualizer.infoVisualizer[*].displayInfos true

